# Any PostgreSQL server. Local:
#   DATABASE_URL='postgresql://localhost:5432/portfolio'
# Hosted (Neon, Supabase, RDS, …) — append the SSL mode the provider requires:
#   DATABASE_URL='postgresql://{DB_USER}:{DB_PASSWORD}@{DB_HOST}/{DB_NAME}?sslmode=verify-full'
DATABASE_URL='postgresql://localhost:5432/portfolio'
# Optional: max connections in the pool (default 10). Lower it on serverless
# hosts or when the database enforces a small connection limit.
DATABASE_POOL_MAX=
UPLOADTHING_TOKEN=
# SHA-256 hex digest of the admin password (never store the plain password).
# Generate on Linux with:  printf '%s' 'your-password' | sha256sum | awk '{print $1}'
ADMIN_PASSWORD=
# Random session-signing secret. Generate with:  openssl rand -hex 32
AUTH_SECRET=
NEXT_PUBLIC_APP_URL='http://localhost:3000'
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key (server-side verification). Get both keys at
# https://dash.cloudflare.com/?to=/:account/turnstile — never expose this one.
# Leave both unset in development to skip the challenge; in production a
# missing secret rejects every submission.
CLOUDFLARE_TURNSTILE_SECRET_KEY=